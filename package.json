  ,"enable-hooks": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.10"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "three": "^0.160.0"
  }
}
